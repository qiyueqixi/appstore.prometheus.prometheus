APP_RUN_USER="prometheus-control"
APP_RUN_GROUP="prometheus-control"
PACKAGE_SHARE="/var/apps/prometheus.control/shares/prometheus-control"
MANAGER_PORT="19090"
PROMETHEUS_PORT="19091"
MIGRATION_ENABLED="true"
ORIGINAL_PROMETHEUS_SHARE="/var/apps/prometheus.prometheus/shares/prometheus/prometheus"
MIGRATION_COMMAND="sudo /var/apps/prometheus.control/target/cmd/migrate_from_original"
NORMALIZE_SHARE_OWNERSHIP="true"
