[manifest]
desc="Prometheus Control は、公式 Prometheus を基盤とする独立した fnOS アプリです。19090 ポートで Go 製のグラフィカル設定画面を提供し、公式 Web UI も内蔵します。独立したアプリ ID とデータディレクトリを使用し、元のパッケージから設定と TSDB 履歴をコピーする移行スクリプトを同梱しています。<br>詳細は <a target="_blank" href="https://prometheus.io/">Prometheus 公式ドキュメント</a>を参照してください。"
[install]
migration_title="元の Prometheus から移行"
migration_help="Prometheus Control は独立したアプリ ID、19090 ポート、データディレクトリを使用します。App Center で両方の Prometheus を停止してから、SSH で次を実行してください：<br>sudo /var/apps/prometheus.control/target/cmd/migrate_from_original<br><b>cp、rsync、ファイルマネージャーで Control の data ディレクトリへ直接上書きしないでください。</b>新旧 WAL が混在すると Prometheus は起動できません。スクリプトは一時領域へコピーし、WAL 番号を検証して既存ファイルをロールバックディレクトリへ移動します。「移行完了」と表示された後に Control を起動してください。"
basic_auth_users_title="basic_auth_users作成"
basic_auth_users_help="應用取附前、basic_auth_users生成ノ爲、使用者名及暗號ヲ指定被下度候。不要之場合、本機能ハ無効ノ儘ニテ可候。"
enable_basic_auth_users="basic_auth_users有効化"
username_label="使用者名"
username_required="使用者名入力被下度候"
username_pattern="使用者名ハ英字及數字ノミ使用可候"
password_label="暗號"
password_required="暗號入力被下度候"
password_pattern="暗號ハ英字及數字ノミ使用可候"
