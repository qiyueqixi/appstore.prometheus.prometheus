[manifest]
desc="Prometheus Control is an independent fnOS application built around upstream Prometheus. It exposes a Go-based graphical configuration portal on port 19090 and embeds the original Prometheus Web UI. It uses its own application ID and data directory, and includes a migration script for copying configuration and historical TSDB data from the original package. Configuration changes are validated, backed up, and hot-reloaded automatically.<br>See the <a target="_blank" href="https://prometheus.io/">Prometheus documentation</a> for upstream details.<br>This package is provided and maintained by community users."
[install]
migration_title="Migrate from the original Prometheus package"
migration_help="Prometheus Control uses a separate application ID, port 19090, and data directory. Stop both Prometheus applications in App Center, then run over SSH:<br>sudo /var/apps/prometheus.control/target/cmd/migrate_from_original<br><b>Do not merge the original data with Control using cp, rsync, or a file manager.</b> Mixing new and old WAL segments prevents Prometheus from starting. The script copies into staging, validates WAL sequences, and moves existing Control files into a rollback directory. Start Control only after the script reports completion. A full copy requires additional disk space."
basic_auth_users_title="Create basic_auth_users"
basic_auth_users_help="Before installing the application, specify a username and password to generate basic_auth_users. <br>If you do not need this feature, you can leave it disabled."
enable_basic_auth_users="Enable basic_auth_users"
username_label="Username"
username_required="Please enter a username"
username_pattern="The username can contain only letters and numbers"
password_label="Password"
password_required="Please enter a password"
password_pattern="The password can contain only letters and numbers"
